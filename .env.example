# Copy to .env.local for local dev. Production values are set as GitHub Actions
# repo secrets and consumed by the deploy workflow.
#
# Leave these blank to run the app in pure-local mode (no cloud sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base path for GitHub Pages. Leave as /Bills/ unless you publish elsewhere.
VITE_BASE_PATH=/Bills/
